[Unit]
Description=Sniper sanitized research observation and read-only market audit
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=beroun
Group=beroun
WorkingDirectory=/opt/sniper/current/platform/research
ExecStart=/usr/bin/python3 -B /opt/sniper/current/platform/research/operational_observation.py
StateDirectory=sniper/observations
StateDirectoryMode=0755
UMask=0022
Environment="PGOPTIONS=-c default_transaction_read_only=on"
TimeoutStartSec=45
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/sniper/observations
