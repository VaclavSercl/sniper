[Unit]
Description=Sniper bounded T1 candle research (no trading)
After=postgresql.service

[Service]
Type=oneshot
User=beroun
Group=beroun
StateDirectory=sniper/candle-research
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/sniper/current/platform/research/candle_research.py cycle --state-dir /var/lib/sniper/candle-research --policy /etc/sniper/candle-research-policy.json
Environment=PGOPTIONS=-cdefault_transaction_read_only=on
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sniper/candle-research
RestrictAddressFamilies=AF_UNIX
MemoryMax=1G
