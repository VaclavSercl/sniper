[Unit]
Description=Sniper Armada v21.0 — Sovereign HFT Trading System
Documentation=https://github.com/VaclavSercl/HFT-Sniper

# ═══ IRON SEQUENCE (Železná Posloupnost) ═══
# Armada starts ONLY after Cortex is fully running.
# Cortex itself waits for MMap allocation.
# Dependency chain: network → mmap → cortex → armada
Requires=sovereign-cortex.service
After=sovereign-cortex.service

[Service]
# ═══ TYPE: oneshot + RemainAfterExit ═══
# deploy_armada.sh launches background processes and exits.
# Type=oneshot tells systemd "ExecStart finishes = service is up".
# RemainAfterExit=yes keeps the service in "active" state even after
# ExecStart returns, so systemd does NOT kill the child processes.
Type=oneshot
RemainAfterExit=yes

User=wwwenda
Group=wwwenda
WorkingDirectory=/home/wwwenda/sniper

# ═══ EXECUTION ═══
ExecStart=/home/wwwenda/sniper/deploy_armada.sh
ExecStop=/home/wwwenda/sniper/infra/stop_armada.sh

# ═══ TIMEOUTS ═══
# deploy_armada.sh takes ~30s for boot sequence, but keeping 180s to be safe.
TimeoutStartSec=180
TimeoutStopSec=30

# ═══ RESTART POLICY ═══
# Only restart on genuine crashes, not on clean stop
Restart=on-failure
RestartSec=60
StartLimitIntervalSec=600
StartLimitBurst=3

# ═══ RESOURCE LIMITS ═══
LimitNOFILE=65535
LimitMEMLOCK=infinity
TasksMax=128

# ═══ SCHEDULING ═══
Nice=-15
CPUAffinity=0 1 2

# ═══ MEMORY ═══
OOMPolicy=continue
OOMScoreAdjust=-900

# ═══ ENVIRONMENT ═══
Environment=HOME=/home/wwwenda
Environment=RUST_LOG=info
EnvironmentFile=/home/wwwenda/sniper/.env

# ═══ SECURITY ═══
ProtectSystem=strict
ReadWritePaths=/home/wwwenda/sniper /dev/shm/beroun /tmp
PrivateTmp=false
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
