# Sniper Armada v11.1 — Configuration
# Copy to .env and fill in your values

# Bitfinex API (required)
BITFINEX_API_KEY=your_api_key_here
BITFINEX_API_SECRET=your_api_secret_here

# Telegram Bot (optional — needed for C2 interface)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Gemini AI (optional — needed for L2 Oracle)
GEMINI_API_KEY=your_gemini_key
