[Unit]
Description=Beroun Sniper v9.0 Hydra — Sovereign HFT Suite
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=wwwenda
WorkingDirectory=/home/wwwenda/hft-sniper

# ═══ DEZINFEKČNÍ PROTOKOL (Ghost-in-the-Machine prevention) ═══
ExecStartPre=-/usr/bin/pkill -9 -f beroun-core
ExecStartPre=-/usr/bin/pkill -9 -f beroun-sovereign-ai
ExecStartPre=-/usr/bin/pkill -9 -f beroun-tele-brain
ExecStartPre=-/usr/bin/pkill -9 -f beroun-dashboard
ExecStartPre=-/usr/bin/rm -f /tmp/beroun-sniper.lock
ExecStartPre=/usr/bin/sleep 1

ExecStart=/home/wwwenda/hft-sniper/beroun-start.sh
Restart=always
RestartSec=3

# Logging handled by tracing-appender (non-blocking daily rotation)
# stdout/stderr only for crash diagnostics
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
