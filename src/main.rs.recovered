use std::time::Duration;
use tokio::time::sleep;
use serde_json::{json, Value};
use std::process::Command;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    dotenvy::dotenv().ok();
    let token = env::var("TELEGRAM_BOT_TOKEN").expect("Chybí TELEGRAM_BOT_TOKEN");
    let allowed_chat_id: i64 = env::var("TELEGRAM_CHAT_ID").expect("Chybí TELEGRAM_CHAT_ID").parse()?;

    println!("🐺 --- BEROUN TELE-BRAIN v1.5 (Loop-Fix) ONLINE ---");

    let client = reqwest::Client::builder().timeout(Duration::from_secs(30)).build()?;
    
    // INICIALIZACE OFFSETU: Přeskočíme staré zprávy při startu
    let mut offset = 0;
    let init_url = format!("https://api.telegram.org/bot{}/getUpdates", token);
    if let Ok(res) = client.get(&init_url).query(&[("offset", "-1")]).send().await {
        if let Ok(json) = res.json::<Value>().await {
            if let Some(updates) = json["result"].as_array() {
                if let Some(last) = updates.last() {
                    offset = last["update_id"].as_i64().unwrap_or(0) + 1;
                    println!("🚀 Offset inicializován na: {}", offset);
                }
            }
        }
    }

    loop {
        let url = format!("https://api.telegram.org/bot{}/getUpdates", token);
        let res = match client.get(&url).query(&[("offset", offset.to_string()), ("timeout", "20".to_string())]).send().await {
            Ok(r) => r, Err(_) => { sleep(Duration::from_secs(5)).await; continue; }
        };
        let json_res: Value = match res.json().await { Ok(v) => v, Err(_) => { sleep(Duration::from_secs(1)).await; continue; } };

        if let Some(updates) = json_res["result"].as_array() {
            for update in updates {
                // OKAMŽITÁ AKTUALIZACE OFFSETU - Nejdůležitější změna
                let current_update_id = update["update_id"].as_i64().unwrap_or(0);
                offset = current_update_id + 1;

                if let Some(msg) = update.get("message") {
                    let chat_id = msg["chat"]["id"].as_i64().unwrap_or(0);
                    if chat_id != allowed_chat_id { continue; }

                    if let Some(text) = msg["text"].as_str() {
                        println!("📥 Telegram [{}]: {}", chat_id, text);
                        
                        let ack_url = format!("https://api.telegram.org/bot{}/sendMessage", token);
                        let _ = client.post(&ack_url).json(&json!({"chat_id": chat_id, "text": "⏳ _Beroun přemýšlí..._", "parse_mode": "Markdown"})).send().await;

                        let prompt = format!("Uživatel se ptá: '{}'. Odpověz jako Beroun AI krátce.", text);
                        
                        let output = Command::new("/usr/local/bin/gemini")
                            .env("HOME", "/home/wwwenda")
                            .arg("-p").arg(&prompt)
                            .arg("--yolo")
                            .current_dir("/home/wwwenda/beroun-projects/beroun-core")
                            .output();

                        let reply = match output {
                            Ok(out) => {
                                let stdout = String::from_utf8_lossy(&out.stdout).to_string();
                                let cleaned: String = stdout.lines()
                                    .filter(|l| !l.contains("YOLO") && !l.contains("Keychain") && !l.contains("Loaded"))
                                    .collect::<Vec<_>>()
                                    .join("\
");
                                if cleaned.trim().is_empty() { "✅ Hotovo.".to_string() } else { cleaned }
                            }
                            Err(e) => format!("❌ AI Error: {}", e),
                        };

                        let _ = client.post(&ack_url).json(&json!({"chat_id": chat_id, "text": reply.trim()})).send().await;
                    }
                }
            }
        }
        sleep(Duration::from_millis(500)).await;
    }
}
