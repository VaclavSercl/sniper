use std::time::{SystemTime, UNIX_EPOCH, Instant, Duration};
use std::fs::{OpenOptions};
use std::sync::LazyLock;
use futures_util::{StreamExt, SinkExt};
use serde_json::{json, Value};
use tokio_tungstenite::{connect_async, tungstenite::protocol::Message};
use hmac::{Hmac, Mac};
use sha2::Sha384;
use dotenvy::dotenv;
use tracing::{info, Level, error, warn};
use tracing_subscriber::{fmt, prelude::*, EnvFilter};
use memmap2::MmapMut;
use zerocopy::{FromBytes, Immutable, IntoBytes};
use anyhow::{Context, Result};

static RISK_STATE_PATH: LazyLock<String> = LazyLock::new(|| "/home/wwwenda/beroun-brain/short_term/risk_state.bin".to_string());
static ENGINE_STATE_PATH: LazyLock<String> = LazyLock::new(|| "/home/wwwenda/beroun-brain/short_term/engine_state.bin".to_string());
const BITFINEX_AUTH_URL: &str = "wss://api.bitfinex.com/ws/2";

type HmacSha384 = Hmac<Sha384>;

struct Notifier {
    token: String,
    chat_id: String,
    client: reqwest::Client,
}

impl Notifier {
    fn new() -> Self {
        Self {
            token: std::env::var("TELEGRAM_BOT_TOKEN").unwrap_or_default(),
            chat_id: std::env::var("TELEGRAM_CHAT_ID").unwrap_or_default(),
            client: reqwest::Client::builder().timeout(Duration::from_secs(10)).build().unwrap(),
        }
    }

    async fn send(&self, msg: &str) {
        info!(event = "alert_log", message = msg);
        if let Ok(mut file) = OpenOptions::new().create(true).append(true).open("/home/wwwenda/beroun-brain/short_term/alerts.log") {
            use std::io::Write;
            let _ = writeln!(file, "[{:?}] {}", SystemTime::now(), msg);
        }

        if self.token.is_empty() || self.chat_id.is_empty() { return; }
        let url = format!("https://api.telegram.org/bot{}/sendMessage", self.token);
        let _ = self.client.post(url)
            .json(&json!({"chat_id": self.chat_id, "text": format!("🐺 *BEROUN ALERT*\
`{}`", msg), "parse_mode": "Markdown"}))
            .send().await;
    }
}

#[derive(Copy, Clone, FromBytes, IntoBytes, Immutable, Debug, Default)]
#[repr(C, align(64))]
struct EngineState {
    best_bid: f64, best_ask: f64, latency_ns: f64, net_position: f64, realized_pnl: f64, _padding: [u8; 24],
}

#[derive(Copy, Clone, FromBytes, IntoBytes, Immutable, Debug)]
#[repr(C, align(64))]
struct RiskState {
    grid_step: f64, grid_size: u64, order_usd: f64, max_inv_delta: f64, bias_offset: f64, paused: u64, _padding: [u8; 16],
}

impl Default for RiskState {
    fn default() -> Self {
        Self { grid_step: 10.0, grid_size: 2, order_usd: 15.0, max_inv_delta: 0.001, bias_offset: 0.0, paused: 0, _padding: [0; 16] }
    }
}

fn init_mmap<T: Default + IntoBytes + FromBytes + Immutable>(path: &str) -> Result<MmapMut> {
    let file = OpenOptions::new().read(true).write(true).create(true).open(path)?;
    file.set_len(std::mem::size_of::<T>() as u64)?;
    let mut mmap = unsafe { MmapMut::map_mut(&file)? };
    if mmap.iter().all(|&b| b == 0) { mmap.copy_from_slice(T::default().as_bytes()); }
    Ok(mmap)
}

async fn get_sig(sec: &str, payload: &str) -> String {
    let mut mac = HmacSha384::new_from_slice(sec.as_bytes()).expect("HMAC error");
    mac.update(payload.as_bytes());
    hex::encode(mac.finalize().into_bytes())
}

#[tokio::main]
async fn main() -> Result<()> {
    dotenv().ok();
    tracing_subscriber::registry().with(fmt::layer().with_target(false).json()).with(EnvFilter::from_default_env().add_directive(Level::INFO.into())).init();
    
    let notifier = Notifier::new();
    let risk_mmap = init_mmap::<RiskState>(&RISK_STATE_PATH)?;
    let mut engine_mmap = init_mmap::<EngineState>(&ENGINE_STATE_PATH)?;
    
    let key = std::env::var("BITFINEX_API_KEY")?;
    let sec = std::env::var("BITFINEX_API_SECRET")?;

    notifier.send("🐺 Beroun Sniper v4.9.11 START").await;

    loop {
        let (ws, _) = match connect_async(BITFINEX_AUTH_URL).await {
            Ok(v) => v,
            Err(e) => { 
                let err_str = format!("{:?}", e);
                if err_str.contains("503") {
                    notifier.send("⚠️ Bitfinex: Údržba (503)").await;
                } else {
                    notifier.send("❌ Bitfinex: Spojení selhalo").await;
                }
                tokio::time::sleep(Duration::from_secs(60)).await; continue; 
            }
        };
        let (mut write, mut read) = ws.split();
        let nonce = SystemTime::now().duration_since(UNIX_EPOCH)?.as_millis().to_string();
        let auth_payload = format!("AUTH{}", nonce);
        let sig = get_sig(&sec, &auth_payload).await;

        write.send(Message::Text(json!({"event": "auth", "apiKey": key, "authSig": sig, "authPayload": auth_payload, "authNonce": nonce, "dms": 4}).to_string().into())).await?;
        write.send(Message::Text(json!({"event": "subscribe", "channel": "ticker", "symbol": "tBTCUSD"}).to_string().into())).await?;

        let mut chan_id: Option<i64> = None;
        let mut last_upd = Instant::now();
        let mut authed = false;

        while let Some(msg) = read.next().await {
            let start_process = Instant::now();
            let msg = match msg { Ok(m) => m, Err(_) => break };
            let Message::Text(text) = msg else { continue };
            let v: Value = serde_json::from_str(&text).unwrap_or_default();

            if v.is_object() {
                if v["event"] == "auth" && v["status"] == "OK" { info!(event = "auth_ok"); authed = true; }
                if v["event"] == "subscribed" { chan_id = v["chanId"].as_i64(); }
            } else if let Some(arr) = v.as_array() {
                if arr[0].as_i64() == chan_id && chan_id.is_some() {
                    if arr[1] == "hb" { continue; }
                    let price = if arr[1].is_array() { arr[1][6].as_f64() } else { arr[7].as_f64() };

                    if let Some(p) = price {
                        let risk: RiskState = unsafe { std::ptr::read_unaligned(risk_mmap.as_ptr() as *const RiskState) };
                        let mut est: EngineState = unsafe { std::ptr::read_unaligned(engine_mmap.as_ptr() as *const EngineState) };
                        est.best_bid = p; est.best_ask = p; est.latency_ns = start_process.elapsed().as_nanos() as f64;
                        engine_mmap.copy_from_slice(est.as_bytes());

                        if authed && last_upd.elapsed().as_millis() > 2000 {
                            let btc_amount = (risk.order_usd / p).max(0.00015);
                            let ops = vec![
                                json!(["oc_multi", {"symbol": "tBTCUSD"}]),
                                json!(["on", {"type": "EXCHANGE LIMIT", "symbol": "tBTCUSD", "price": format!("{:.1}", p - risk.grid_step), "amount": format!("{:.5}", btc_amount), "flags": 4096}]),
                                json!(["on", {"type": "EXCHANGE LIMIT", "symbol": "tBTCUSD", "price": format!("{:.1}", p + risk.grid_step), "amount": format!("{:.5}", -btc_amount), "flags": 4096}])
                            ];
                            let _ = write.send(Message::Text(json!([0, "ox_multi", null, ops]).to_string().into())).await;"
use std::time::{Duration, Instant, SystemTime};
use std::sync::{Arc, Mutex, LazyLock};
use zerocopy::{FromBytes, Immutable, IntoBytes};
use tokio_tungstenite::{connect_async, tungstenite::protocol::Message};
use futures_util::{StreamExt, SinkExt};
use serde_json::{json, Value};
use axum::{extract::ws::{WebSocket, WebSocketUpgrade, Message as AxumMessage}, response::IntoResponse, routing::get, Router};
use tower_http::cors::CorsLayer;
use dotenvy::dotenv;
use anyhow::{Context, Result};

static RISK_STATE_PATH: LazyLock<String> = LazyLock::new(|| "/home/wwwenda/beroun-brain/short_term/risk_state.bin".to_string());
static ENGINE_STATE_PATH: LazyLock<String> = LazyLock::new(|| "/home/wwwenda/beroun-brain/short_term/engine_state.bin".to_string());
const BITFINEX_PUB_URL: &str = "wss://api-pub.bitfinex.com/ws/2";

#[derive(Copy, Clone, FromBytes, IntoBytes, Immutable, Debug, Default)]
#[repr(C, align(64))]
struct EngineState {
    best_bid: f64, best_ask: f64, latency_ns: f64, net_position: f64, realized_pnl: f64,
    _padding: [u8; 24],
}

#[derive(Copy, Clone, FromBytes, IntoBytes, Immutable, Debug)]
#[repr(C, align(64))]
struct RiskState {
    grid_step: f64, grid_size: u64, order_usd: f64, max_inv_delta: f64, bias_offset: f64, paused: u64,
    _padding: [u8; 16],
}

impl Default for RiskState {
    fn default() -> Self {
        Self { 
            grid_step: 10.0, grid_size: 2, order_usd: 15.0, 
            max_inv_delta: 0.001, bias_offset: 0.0, paused: 0,
            _padding: [0; 16]
        }
    }
}

#[derive(Debug, Default, serde::Serialize, Clone)]
struct DashboardData {
    mid_price: f64, latency_ms: f64, position: f64, realized_pnl: f64, timestamp: u64,
    grid_base: f64, grid_step: f64, grid_size: u64,
}

fn init_mmap<T: Default + IntoBytes + FromBytes + Immutable>(path: &str) -> Result<MmapMut> {
    let file = OpenOptions::new().read(true).write(true).create(true).open(path)?;
    file.set_len(std::mem::size_of::<T>() as u64)?;
    let mut mmap = unsafe { MmapMut::map_mut(&file)? };
    if mmap.iter().all(|&b| b == 0) { mmap.copy_from_slice(T::default().as_bytes()); }
    Ok(mmap)
}

async fn websocket_stream(mut socket: WebSocket, dashboard: Arc<Mutex<DashboardData>>) {
    let mut interval = tokio::time::interval(Duration::from_millis(500));
    loop {
        interval.tick().await;
        let data = {
            let db = dashboard.lock().expect("Lock failed");
            serde_json::to_string(&*db).unwrap_or_default()
        };
        if socket.send(AxumMessage::Text(data.into())).await.is_err() { break; }
    }
}

async fn ws_handler(ws: WebSocketUpgrade, dashboard: Arc<Mutex<DashboardData>>) -> impl IntoResponse {
    ws.on_upgrade(move |socket| websocket_stream(socket, dashboard))
}

#[tokio::main]
async fn main() -> Result<()> {
    dotenv().ok();
    println!("--- BEROUN AI MANAGER v4.9.9-rust2024 ---");
    let dashboard = Arc::new(Mutex::<DashboardData>::default());
    let d_clone = dashboard.clone();
    
    tokio::spawn(async move {
        let app = Router::new()
            .route("/", get(|| async { axum::response::Html(include_str!("../dashboard.html")) }))
            .route("/ws", get(move |ws| ws_handler(ws, d_clone)))
            .layer(CorsLayer::permissive());
        let listener = tokio::net::TcpListener::bind("0.0.0.0:3000").await.unwrap();
        println!("[SERVER] Dashboard online at port 3000");
        axum::serve(listener, app).await.unwrap();
    });

    let mut r_mmap = init_mmap::<RiskState>(&RISK_STATE_PATH)?;
    let mut e_mmap = init_mmap::<EngineState>(&ENGINE_STATE_PATH)?;
    
    loop {
        let ws_result = connect_async(BITFINEX_PUB_URL).await;
        if let Err(e) = ws_result {
            eprintln!("[WS] Connection error: {:?}. Retrying...", e);
            tokio::time::sleep(Duration::from_secs(10)).await;
            continue;
        }
        
        let (mut ws_write, mut ws_read) = ws_result.unwrap().0.split();
        ws_write.send(Message::Text(json!({"event": "subscribe", "channel": "ticker", "symbol": "tBTCUSD"}).to_string().into())).await?;
        
        while let Some(msg) = ws_read.next().await {
            let msg = match msg { Ok(m) => m, Err(_) => break };
            let Message::Text(text) = msg else { continue };
            let v: Value = serde_json::from_str(&text).unwrap_or_default();
            
            if let Some(arr) = v.as_array() {
                let price = if arr.len() > 1 && arr[1].is_array() { arr[1][6].as_f64() } 
                            else if arr.len() >= 8 { arr[7].as_f64() } else { None };
                
                if let Some(p) = price {
                    let r: RiskState = unsafe { std::ptr::read_unaligned(r_mmap.as_ptr() as *const RiskState) };
                    let e: EngineState = unsafe { std::ptr::read_unaligned(e_mmap.as_ptr() as *const EngineState) };
                    
                    let mut db = dashboard.lock().expect("Lock failed");
                    db.mid_price = p; 
                    db.latency_ms = e.latency_ns / 1_000_000.0;
                    db.position = e.net_position; 
                    db.realized_pnl = e.realized_pnl;
                    db.grid_base = p; db.grid_step = r.grid_step; db.grid_size = r.grid_size;
                    db.timestamp = SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs();
                }
            }
        }
        tokio::time::sleep(Duration::from_secs(5)).await;
    }
}
