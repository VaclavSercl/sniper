[Unit]
Description=Sniper Armada v14.0 — Separated Hemispheres HFT + AI + Telegram C2
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=wwwenda
WorkingDirectory=/home/wwwenda/sniper
ExecStartPre=/usr/bin/mkdir -p /dev/shm/beroun
ExecStart=/home/wwwenda/sniper/deploy_armada.sh
Restart=always
RestartSec=10

# Performance
Nice=-10
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50
LimitNOFILE=65535
LimitMEMLOCK=infinity

# Environment
EnvironmentFile=/home/wwwenda/sniper/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sniper-armada

[Install]
WantedBy=multi-user.target
