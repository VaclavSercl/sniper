[Unit]
Description=Sniper Armada v11.2 — 3-Bot HFT Platform (Hydra + Moonshot + Grid)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=wwwenda
WorkingDirectory=/home/wwwenda/hft-sniper
ExecStart=/home/wwwenda/hft-sniper/deploy_armada.sh
Restart=always
RestartSec=5

# Performance
Nice=-10
LimitNOFILE=65535
LimitMEMLOCK=infinity

# Environment
EnvironmentFile=/home/wwwenda/hft-sniper/.env

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
