[Unit]
Description=Sniper Armada v11.2 — Multi-Bot HFT + Telegram C2
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=wwwenda
WorkingDirectory=/home/wwwenda/sniper
ExecStart=/home/wwwenda/sniper/deploy_armada.sh
Restart=always
RestartSec=10

# Performance
Nice=-10
LimitNOFILE=65535
LimitMEMLOCK=infinity

# Environment
EnvironmentFile=/home/wwwenda/sniper/.env

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
